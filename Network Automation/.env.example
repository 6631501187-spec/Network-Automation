# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- Secrets ---
GROQ_API_KEY=
SSH_PASSWORD=

# --- AI (Groq, OpenAI-compatible API, image-capable model) ---
GROQ_MODEL=qwen/qwen3.8-27b

# --- Router SSH ---
SSH_USERNAME=admin
# Management addresses come from DHCP: read them with `show ip interface brief`
# after every lab start, then run: .venv/bin/python lab/check_routers.py
R1_HOST=192.168.115.133
R2_HOST=192.168.115.134

# --- Real interface names in the GNS3 lab (given to the AI as inventory) ---
R1_MANAGEMENT_INTERFACE=FastEthernet0/0
R1_TRANSIT_INTERFACE=FastEthernet1/0
R1_LAN_INTERFACE=FastEthernet2/0
R2_MANAGEMENT_INTERFACE=FastEthernet0/0
R2_TRANSIT_INTERFACE=FastEthernet1/0
R2_LAN_INTERFACE=FastEthernet2/0

# --- Kafka / backend ---
KAFKA_BOOTSTRAP_SERVERS=localhost:39092
KAFKA_TOPIC=network-config-jobs
BACKEND_URL=http://127.0.0.1:8000
OSPF_VERIFY_TIMEOUT=120
